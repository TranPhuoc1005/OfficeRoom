# ============================================================================
# PIXEL OFFICE - LOCAL WINDOWS RUNNER CONFIGURATION
# ============================================================================
# Connects outbound to Supabase over HTTPS (no open ports or public localhost required)

# Supabase Project URL (From Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public Key (From Supabase Dashboard -> Project Settings -> API)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Windows Runner ID (UUID generated from Web UI or pairing tool)
RUNNER_ID=00000000-0000-0000-0000-000000000000

# Runner Secret Token (Keep private; never commit or share)
RUNNER_SECRET_TOKEN=rnt_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Friendly name for this workstation
RUNNER_NAME=Windows Workstation (Work)
